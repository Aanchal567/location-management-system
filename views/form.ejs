<!DOCTYPE html>
<html>
<head>
    <title>Add Location</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
            min-height: 100vh;
        }
        
        .container {
            max-width: 650px;
            margin: 0 auto;
        }
        
        .form-box {
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        
        h2 {
            margin-top: 0;
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }
        
        input, select, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s;
            box-sizing: border-box;
        }
        
        input:focus, select:focus, textarea:focus {
            border-color: #667eea;
            outline: none;
        }
        
        textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        button[type="submit"] {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        button[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #667eea;
            text-decoration: none;
        }
        
        .back-link:hover {
            text-decoration: underline;
        }
        
        select:disabled {
            background: #f5f5f5;
            cursor: not-allowed;
        }
        
        .selected-info {
            background: #e8f5e9;
            padding: 12px;
            border-radius: 10px;
            margin-top: 15px;
            font-size: 14px;
            text-align: center;
        }
        
        .file-info {
            background: #f0f0f0;
            padding: 10px;
            border-radius: 8px;
            margin-top: 10px;
            font-size: 12px;
        }
        
        .required-star {
            color: red;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-box">
            <h2><%= edit ? '✏️ Edit Location' : '📍 Add New Location' %></h2>
            
            <form action="<%= edit ? '/update/' + edit.id : '/add' %>" method="POST" enctype="multipart/form-data" id="locationForm">
                <!-- Hidden fields for coordinates -->
                <input type="hidden" name="latitude" id="selectedLat">
                <input type="hidden" name="longitude" id="selectedLng">
                <input type="hidden" name="city" id="selectedCityName">
                
                <!-- Basic Information -->
                <div class="form-group">
                    <label>🏷️ Location Name <span class="required-star">*</span></label>
                    <input type="text" name="name" value="<%= edit ? edit.name : '' %>" required placeholder="Enter location name">
                </div>
                
                <div class="form-group">
                    <label>📌 Type <span class="required-star">*</span></label>
                    <select name="type" required>
                        <option value="">-- Select Type --</option>
                        <option value="payment" <%= edit && edit.type === 'payment' ? 'selected' : '' %>>💳 Payment</option>
                        <option value="event" <%= edit && edit.type === 'event' ? 'selected' : '' %>>🎉 Event</option>
                        <option value="delivery" <%= edit && edit.type === 'delivery' ? 'selected' : '' %>>📦 Delivery</option>
                        <option value="office" <%= edit && edit.type === 'office' ? 'selected' : '' %>>🏢 Office</option>
                        <option value="shop" <%= edit && edit.type === 'shop' ? 'selected' : '' %>>🛍️ Shop</option>
                        <option value="restaurant" <%= edit && edit.type === 'restaurant' ? 'selected' : '' %>>🍽️ Restaurant</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>ℹ️ Description <span class="required-star">*</span></label>
                    <textarea name="info" rows="3" required placeholder="Enter location information"><%= edit ? edit.info : '' %></textarea>
                </div>
                
                <!-- Location Selector: Country → State → City -->
                <div class="form-group">
                    <label>🌍 Country <span class="required-star">*</span></label>
                    <select id="countrySelect" onchange="loadStates()">
                        <option value="">-- Select Country --</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>🗺️ State <span class="required-star">*</span></label>
                    <select id="stateSelect" onchange="loadCities()" disabled>
                        <option value="">-- Select Country First --</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>🏙️ City <span class="required-star">*</span></label>
                    <select id="citySelect" onchange="selectCity()" disabled>
                        <option value="">-- Select State First --</option>
                    </select>
                </div>
                
                <div id="selectedInfo" class="selected-info" style="display: none;"></div>
                
                <!-- File Upload -->
                <div class="form-group">
                    <label>📎 Attach Document (Optional)</label>
                    <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                    <% if (edit && edit.document) { %>
                        <div class="file-info">
                            📄 Current file: <a href="/uploads/<%= edit.document %>" target="_blank">View Document</a>
                        </div>
                    <% } %>
                </div>
                
                <button type="submit"><%= edit ? '✏️ Update Location' : '➕ Add Location' %></button>
            </form>
            
            <a href="/locations" class="back-link">← Back to Locations</a>
        </div>
    </div>
    
    <script>
        // Load countries on page load
        async function loadCountries() {
            try {
                const response = await fetch('/api/countries');
                const countries = await response.json();
                const select = document.getElementById('countrySelect');
                
                select.innerHTML = '<option value="">-- Select Country --</option>';
                countries.forEach(country => {
                    select.innerHTML += `<option value="${country.code}">${country.name}</option>`;
                });
                
                <% if (edit && edit.city) { %>
                    // If editing, we need to load the existing location
                    setTimeout(() => loadExistingLocation(), 500);
                <% } %>
            } catch (error) {
                console.error('Error loading countries:', error);
            }
        }
        
        // Load states based on selected country
        async function loadStates() {
            const countryCode = document.getElementById('countrySelect').value;
            const stateSelect = document.getElementById('stateSelect');
            const citySelect = document.getElementById('citySelect');
            
            if (!countryCode) {
                stateSelect.innerHTML = '<option value="">-- Select Country First --</option>';
                stateSelect.disabled = true;
                citySelect.innerHTML = '<option value="">-- Select State First --</option>';
                citySelect.disabled = true;
                return;
            }
            
            stateSelect.disabled = false;
            stateSelect.innerHTML = '<option value="">Loading states...</option>';
            
            try {
                const response = await fetch(`/api/states/${countryCode}`);
                const states = await response.json();
                
                stateSelect.innerHTML = '<option value="">-- Select State --</option>';
                states.forEach(state => {
                    stateSelect.innerHTML += `<option value="${state.code}">${state.name}</option>`;
                });
                
                citySelect.innerHTML = '<option value="">-- Select State First --</option>';
                citySelect.disabled = true;
                document.getElementById('selectedInfo').style.display = 'none';
            } catch (error) {
                console.error('Error loading states:', error);
                stateSelect.innerHTML = '<option value="">Error loading states</option>';
            }
        }
        
        // Load cities based on selected state
        async function loadCities() {
            const countryCode = document.getElementById('countrySelect').value;
            const stateCode = document.getElementById('stateSelect').value;
            const citySelect = document.getElementById('citySelect');
            
            if (!stateCode) {
                citySelect.innerHTML = '<option value="">-- Select State First --</option>';
                citySelect.disabled = true;
                return;
            }
            
            citySelect.disabled = false;
            citySelect.innerHTML = '<option value="">Loading cities...</option>';
            
            try {
                const response = await fetch(`/api/cities/${countryCode}/${stateCode}`);
                const cities = await response.json();
                
                citySelect.innerHTML = '<option value="">-- Select City --</option>';
                cities.forEach(city => {
                    citySelect.innerHTML += `<option value="${city.code}" data-lat="${city.lat}" data-lng="${city.lng}" data-name="${city.name}">${city.name}</option>`;
                });
            } catch (error) {
                console.error('Error loading cities:', error);
                citySelect.innerHTML = '<option value="">Error loading cities</option>';
            }
        }
        
        // Select city and update hidden fields
        function selectCity() {
            const citySelect = document.getElementById('citySelect');
            const selectedOption = citySelect.options[citySelect.selectedIndex];
            
            if (selectedOption && selectedOption.value) {
                const lat = selectedOption.dataset.lat;
                const lng = selectedOption.dataset.lng;
                const cityName = selectedOption.dataset.name;
                
                document.getElementById('selectedLat').value = lat;
                document.getElementById('selectedLng').value = lng;
                document.getElementById('selectedCityName').value = cityName;
                
                const selectedInfo = document.getElementById('selectedInfo');
                selectedInfo.style.display = 'block';
                selectedInfo.innerHTML = `✅ Selected: <strong>${cityName}</strong><br>📍 Coordinates: ${lat}, ${lng}`;
            }
        }
        
        // For edit mode - load existing location
        async function loadExistingLocation() {
            const existingCity = '<%= edit ? edit.city : "" %>';
            const existingLat = '<%= edit ? edit.lat : "" %>';
            const existingLng = '<%= edit ? edit.lng : "" %>';
            
            if (existingCity && existingLat && existingLng) {
                document.getElementById('selectedLat').value = existingLat;
                document.getElementById('selectedLng').value = existingLng;
                document.getElementById('selectedCityName').value = existingCity;
                
                const selectedInfo = document.getElementById('selectedInfo');
                selectedInfo.style.display = 'block';
                selectedInfo.innerHTML = `📌 Current Location: <strong>${existingCity}</strong><br>📍 Coordinates: ${existingLat}, ${existingLng}`;
            }
        }
        
        // Form validation before submit
        document.getElementById('locationForm').addEventListener('submit', function(e) {
            const lat = document.getElementById('selectedLat').value;
            const lng = document.getElementById('selectedLng').value;
            const cityName = document.getElementById('selectedCityName').value;
            
            if (!lat || !lng || !cityName) {
                e.preventDefault();
                alert('Please select a city from the dropdown!');
                return false;
            }
        });
        
        // Initialize
        loadCountries();
    </script>
</body>
</html>